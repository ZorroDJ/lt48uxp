static void r6_editor_open(app_widgets*w){lt48_s8253_resources*r=NULL;if(lt48_s8253_open(w->installation,w->selected_device_index,&r))return;r6_editor*e=g_new0(r6_editor,1);e->id=r->configuration_id;e->schema=r6_schema(e->id,&e->count);lt48_s8253_close(r);if(!e->schema){g_free(e);return;}e->w=w;e->device=w->selected_device_index;e->revision=w->operation_input_revision;e->window=GTK_WINDOW(gtk_window_new());gtk_window_set_title(e->window,"Ramtron VRS51 configuration");gtk_window_set_transient_for(e->window,w->window);gtk_window_set_modal(e->window,TRUE);gtk_window_set_default_size(e->window,700,650);GtkWidget*scroll=gtk_scrolled_window_new(),*box=gtk_box_new(GTK_ORIENTATION_VERTICAL,8);gtk_window_set_child(e->window,scroll);gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(scroll),box);GtkWidget*intro=gtk_label_new("Fuse is the boot-area setting0 through8. The protection selector requests an additional code-protect pulse; it does not show current protection. Program and Overprogram erase the whole chip first, clear protection and restore Fuse after verifying code. Erase clears code and Fuse. Configuration writes follow the original source sequence; protection state cannot be verified through this interface. Use the original package adapter. Hardware qualification pending.");gtk_label_set_wrap(GTK_LABEL(intro),TRUE);gtk_box_append(GTK_BOX(box),intro);for(unsigned i=0;i<e->count;i++){GtkWidget*row=gtk_box_new(GTK_ORIENTATION_HORIZONTAL,8);gtk_box_append(GTK_BOX(box),row);e->enable[i]=gtk_check_button_new_with_label(e->schema[i].label);gtk_box_append(GTK_BOX(row),e->enable[i]);if(e->schema[i].category==1){const char*options[5]={0};for(unsigned k=0;k<=e->schema[i].maximum;k++)options[k]=e->schema[i].options[k];e->value[i]=gtk_drop_down_new_from_strings(options);}else{e->value[i]=gtk_entry_new();gtk_editable_set_text(GTK_EDITABLE(e->value[i]),e->schema[i].category==2?"0":"0");}gtk_widget_set_hexpand(e->value[i],TRUE);gtk_box_append(GTK_BOX(row),e->value[i]);}e->error=gtk_label_new("");gtk_box_append(GTK_BOX(box),e->error);GtkWidget*read=gtk_button_new_with_label("Prepare configuration read"),*apply=gtk_button_new_with_label("Prepare selected changes");gtk_box_append(GTK_BOX(box),read);gtk_box_append(GTK_BOX(box),apply);g_object_set_data(G_OBJECT(apply),"apply",GINT_TO_POINTER(1));g_signal_connect(read,"clicked",G_CALLBACK(r6_editor_action),e);g_signal_connect(apply,"clicked",G_CALLBACK(r6_editor_action),e);g_object_set_data_full(G_OBJECT(e->window),"numicro-editor",e,g_free);gtk_window_present(e->window);}
