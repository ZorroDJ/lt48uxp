#include "configuration.h"
typedef struct {app_widgets*w;GtkWindow*window;GtkWidget*enable[32],*value[32],*error;const struct tp6_field*schema;unsigned count,id;size_t device;uint64_t revision;} tp6_editor;
static uint32_t tp6_gui_value(const unsigned char*p){return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
static char*tp6_configuration_message(unsigned id,const unsigned char*v,gboolean edited){(void)id;GString*s=g_string_new(edited?"Protect command accepted; protection-state readback is unavailable.\n":"Protection-state Read unavailable.\n");unsigned count=0;const struct tp6_field*fields=tp6_schema(id,&count);for(unsigned i=0;i<count;i++)g_string_append_printf(s,"%s: %u\n",fields[i].label,tp6_gui_value(v+4*i));g_string_append(s,"Cleanup completed. Hardware qualification pending.");return g_string_free(s,FALSE);}
static void tp6_editor_action(GtkButton*b,gpointer data){tp6_editor*e=data;app_widgets*w=e->w;if(!w->has_selected_device||e->device!=w->selected_device_index||e->revision!=w->operation_input_revision){gtk_window_destroy(e->window);return;}unsigned char edit[132]={0};unsigned mask=0;if(g_object_get_data(G_OBJECT(b),"apply"))for(unsigned i=0;i<e->count;i++){if(!gtk_check_button_get_active(GTK_CHECK_BUTTON(e->enable[i])))continue;uint32_t value;if(e->schema[i].category==1)value=gtk_drop_down_get_selected(GTK_DROP_DOWN(e->value[i]));else{const char*text=gtk_editable_get_text(GTK_EDITABLE(e->value[i]));char*end=NULL;guint64 v=g_ascii_strtoull(text,&end,e->schema[i].category==2?16:10);if(!*text||*end||v>e->schema[i].maximum){gtk_label_set_text(GTK_LABEL(e->error),"Enter 0 or 1 for flags, or a hexadecimal byte from 00 to FF for numeric fields.");return;}value=(uint32_t)v;}if(value>e->schema[i].maximum)return;mask|=1u<<i;for(unsigned k=0;k<4;k++)edit[4+4*i+k]=(unsigned char)(value>>(8*k));}for(unsigned b=0;b<4;b++)edit[b]=mask>>(8*b);memcpy(w->s8253_configuration,edit,sizeof edit);gtk_drop_down_set_selected(GTK_DROP_DOWN(w->operation_dropdown),9);gtk_window_destroy(e->window);w->read_after_prepare=0;start_operation_preparation(w,LT48_OPERATION_CONFIGURATION);}
static void tp6_editor_open(app_widgets*w){lt48_s8253_resources*r=NULL;if(lt48_s8253_open(w->installation,w->selected_device_index,&r))return;tp6_editor*e=g_new0(tp6_editor,1);e->id=r->configuration_id;e->schema=tp6_schema(e->id,&e->count);lt48_s8253_close(r);if(!e->schema){g_free(e);return;}e->w=w;e->device=w->selected_device_index;e->revision=w->operation_input_revision;e->window=GTK_WINDOW(gtk_window_new());gtk_window_set_title(e->window,"TOPRO protection");gtk_window_set_transient_for(e->window,w->window);gtk_window_set_modal(e->window,TRUE);gtk_window_set_default_size(e->window,700,650);GtkWidget*scroll=gtk_scrolled_window_new(),*box=gtk_box_new(GTK_ORIENTATION_VERTICAL,8);gtk_window_set_child(e->window,scroll);gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(scroll),box);GtkWidget*intro=gtk_label_new("Select only settings to change. Use the complete selected code image. Protect is a write-only command; use value 1 to enable it. Standalone Erase clears code. Protection-state Read is unavailable. Program requires blank or compatible 1-to-0 contents. Protection cannot be cleared through this editor. Verify the image before Protect. Use the original package adapter. Hardware qualification pending.");gtk_label_set_wrap(GTK_LABEL(intro),TRUE);gtk_box_append(GTK_BOX(box),intro);for(unsigned i=0;i<e->count;i++){GtkWidget*row=gtk_box_new(GTK_ORIENTATION_HORIZONTAL,8);gtk_box_append(GTK_BOX(box),row);e->enable[i]=gtk_check_button_new_with_label(e->schema[i].label);gtk_box_append(GTK_BOX(row),e->enable[i]);if(e->schema[i].category==1){const char*options[18]={0};for(unsigned k=0;k<=e->schema[i].maximum;k++)options[k]=e->schema[i].options[k];e->value[i]=gtk_drop_down_new_from_strings(options);}else{e->value[i]=gtk_entry_new();gtk_editable_set_text(GTK_EDITABLE(e->value[i]),e->schema[i].category==2?"0":"0");}gtk_widget_set_hexpand(e->value[i],TRUE);gtk_box_append(GTK_BOX(row),e->value[i]);}e->error=gtk_label_new("");gtk_box_append(GTK_BOX(box),e->error);GtkWidget*read=gtk_button_new_with_label("Prepare configuration read"),*apply=gtk_button_new_with_label("Prepare selected changes");gtk_widget_set_sensitive(read,FALSE);gtk_box_append(GTK_BOX(box),read);gtk_box_append(GTK_BOX(box),apply);g_object_set_data(G_OBJECT(apply),"apply",GINT_TO_POINTER(1));g_signal_connect(read,"clicked",G_CALLBACK(tp6_editor_action),e);g_signal_connect(apply,"clicked",G_CALLBACK(tp6_editor_action),e);g_object_set_data_full(G_OBJECT(e->window),"numicro-editor",e,g_free);gtk_window_present(e->window);}

static char*tp6_preparation_message(unsigned op,const char*selector,unsigned length,unsigned id,const unsigned char*values){
 GString*m=g_string_new(NULL);g_string_append_printf(m,"READY TO %s — %s · %u bytes\nTOPRO TP2804/TP2808: raw Read over the selected %uKiB code array. Program and Overprogram require compatible 1-to-0 contents; neither erases automatically. Erase follows the original callback and checks the entire code array. Configuration is separate. Use the original package adapter. Hardware qualification pending.",lt48_operation_kind_name(op),selector,length,length/1024);
 if(op==LT48_OPERATION_CONFIGURATION){unsigned n=0,mask=tp6_gui_value(values);const struct tp6_field*f=tp6_schema(id,&n);g_string_append(m,mask?"\nSelected changes:":"\nProtection-state Read unavailable; select Protect=1 to apply.");for(unsigned i=0;i<n;i++)if(mask>>i&1){unsigned v=tp6_gui_value(values+4+4*i);if(f[i].category==1&&v<=f[i].maximum)g_string_append_printf(m,"\n%s: %s",f[i].label,f[i].options[v]);else if(f[i].category==2)g_string_append_printf(m,"\n%s: %02X",f[i].label,v);else g_string_append_printf(m,"\n%s: %u",f[i].label,v);}}
 return g_string_free(m,FALSE);
}
