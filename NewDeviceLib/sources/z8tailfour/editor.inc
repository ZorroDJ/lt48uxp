/* Explicit one-shot RAM-protection request, shared request storage. */
typedef struct{app_widgets*w;GtkWindow*window;GtkWidget*check;size_t device;uint64_t revision;}z8tail_editor;
static void z8tail_apply(GtkButton*b,gpointer data){(void)b;z8tail_editor*e=data;if(e->w->has_selected_device&&e->w->selected_device_index==e->device&&e->w->operation_input_revision==e->revision){memset(e->w->rb2_configuration,0,sizeof e->w->rb2_configuration);e->w->rb2_configuration[0]=gtk_check_button_get_active(GTK_CHECK_BUTTON(e->check));invalidate_operation_preparation(e->w,1);}gtk_window_destroy(e->window);}
static void z8tail_editor_open(app_widgets*w){z8tail_editor*e=g_new0(z8tail_editor,1);e->w=w;e->device=w->selected_device_index;e->revision=w->operation_input_revision;e->window=GTK_WINDOW(gtk_window_new());gtk_window_set_title(e->window,"Z86E61/E63 RAM protection");gtk_window_set_transient_for(e->window,w->window);gtk_window_set_modal(e->window,TRUE);GtkWidget*box=gtk_box_new(GTK_ORIENTATION_VERTICAL,10);gtk_window_set_child(e->window,box);GtkWidget*t=gtk_label_new("Optional irreversible RAM-protection fuse, programmed during Program or Overprogram. It limits access to upper register RAM when the application enables IMR bit 6. Leaving this unchecked does not clear an existing fuse. The original procedure cannot read its state. Secure separately sets EPROM protection and prevents further code reads. Electrical erase is unavailable. Hardware qualification pending.");gtk_label_set_wrap(GTK_LABEL(t),TRUE);gtk_box_append(GTK_BOX(box),t);e->check=gtk_check_button_new_with_label("Program RAM-protection fuse during this write");gtk_check_button_set_active(GTK_CHECK_BUTTON(e->check),!!w->rb2_configuration[0]);gtk_box_append(GTK_BOX(box),e->check);GtkWidget*b=gtk_button_new_with_label("Use setting");gtk_box_append(GTK_BOX(box),b);g_signal_connect(b,"clicked",G_CALLBACK(z8tail_apply),e);g_object_set_data_full(G_OBJECT(e->window),"z8tail",e,g_free);gtk_window_present(e->window);}
