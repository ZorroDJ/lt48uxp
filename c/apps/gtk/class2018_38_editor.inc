typedef struct{app_widgets*w;GtkWindow*window;GtkWidget*enable[8],*value[8],*error;const struct cl38_field*schema;unsigned count,family;size_t device;uint64_t revision;}cl38_editor;
static char*cl38_configuration_message(unsigned family,const unsigned char*v){unsigned n;const struct cl38_field*f=cl38_schema(family,&n);GString*m=g_string_new("Source configuration read back.\n");for(unsigned i=0;i<n;i++)g_string_append_printf(m,"%s: %X\n",f[i].label,numicro_gui_value(v+4*i));g_string_append(m,"Unselected settings preserved. Cleanup completed.");return g_string_free(m,FALSE);}
static void cl38_editor_action(GtkButton*b,gpointer data){cl38_editor*e=data;app_widgets*w=e->w;if(!w->has_selected_device||e->device!=w->selected_device_index||e->revision!=w->operation_input_revision){gtk_window_destroy(e->window);return;}unsigned char edit[34]={0};if(g_object_get_data(G_OBJECT(b),"apply"))for(unsigned i=0;i<e->count;i++){if(!gtk_check_button_get_active(GTK_CHECK_BUTTON(e->enable[i])))continue;const char*t=gtk_editable_get_text(GTK_EDITABLE(e->value[i]));char*end=NULL;guint64 v=g_ascii_strtoull(t,&end,16);if(!*t||*end||v>e->schema[i].maximum){gtk_label_set_text(GTK_LABEL(e->error),"Enter a hexadecimal value within the displayed field range.");return;}edit[i/8]|=1u<<(i%8);for(unsigned k=0;k<4;k++)edit[2+4*i+k]=(unsigned char)(v>>(8*k));}memcpy(w->mcu51_configuration,edit,sizeof edit);gtk_window_destroy(e->window);w->read_after_prepare=0;start_operation_preparation(w,LT48_OPERATION_CONFIGURATION);}
static void cl38_editor_open(app_widgets*w){lt48_device_spec spec;if(lt48_installation_resolve_device(w->installation,w->selected_device_index,&spec))return;cl38_editor*e=g_new0(cl38_editor,1);e->family=spec.family_code;e->schema=cl38_schema(e->family,&e->count);if(!e->count){g_free(e);return;}e->w=w;e->device=w->selected_device_index;e->revision=w->operation_input_revision;e->window=GTK_WINDOW(gtk_window_new());gtk_window_set_title(e->window,"Legacy class2018 configuration");gtk_window_set_transient_for(e->window,w->window);gtk_window_set_modal(e->window,TRUE);GtkWidget*box=gtk_box_new(GTK_ORIENTATION_VERTICAL,8);gtk_window_set_child(e->window,box);GtkWidget*intro=gtk_label_new("Values are hexadecimal. Unchecked fields are preserved. Raw byte/word labels retain the original field indices. Programmed bits cannot be reversed without the appropriate chip erase (external UV erase on the Infineon OTP part). Protection can block code Read. Use the original package adapter. Hardware qualification pending.");gtk_label_set_wrap(GTK_LABEL(intro),TRUE);gtk_box_append(GTK_BOX(box),intro);for(unsigned i=0;i<e->count;i++){GtkWidget*row=gtk_box_new(GTK_ORIENTATION_HORIZONTAL,8);gtk_box_append(GTK_BOX(box),row);char*label=g_strdup_printf("%s (0–%X)",e->schema[i].label,e->schema[i].maximum);e->enable[i]=gtk_check_button_new_with_label(label);g_free(label);e->value[i]=gtk_entry_new();gtk_editable_set_text(GTK_EDITABLE(e->value[i]),"0");gtk_box_append(GTK_BOX(row),e->enable[i]);gtk_box_append(GTK_BOX(row),e->value[i]);}e->error=gtk_label_new("");gtk_box_append(GTK_BOX(box),e->error);GtkWidget*read=gtk_button_new_with_label("Prepare settings read"),*apply=gtk_button_new_with_label("Prepare selected changes");gtk_box_append(GTK_BOX(box),read);gtk_box_append(GTK_BOX(box),apply);g_object_set_data(G_OBJECT(apply),"apply",GINT_TO_POINTER(1));g_signal_connect(read,"clicked",G_CALLBACK(cl38_editor_action),e);g_signal_connect(apply,"clicked",G_CALLBACK(cl38_editor_action),e);g_object_set_data_full(G_OBJECT(e->window),"cl38-editor",e,g_free);gtk_window_present(e->window);}
