/* P89LPC settings and erase choices; code-memory Read is unavailable. */
static const char*lpcflash_label(unsigned field){static const char*labels[]={"UCFG1 (00–FF)","UCFG2 (00–FF)","Boot vector (00–FF)","Status byte (00–FF)","Sector 0 security (0–7)","Sector 1 security (0–7)","Sector 2 security (0–7)","Sector 3 security (0–7)","Sector 4 security (0–7)","Sector 5 security (0–7)","Sector 6 security (0–7)","Sector 7 security (0–7)","Sector 8 security (0–7)","Sector 9 security (0–7)","Sector 10 security (0–7)","Sector 11 security (0–7)","Sector 12 security (0–7)","Sector 13 security (0–7)","Sector 14 security (0–7)","Sector 15 security (0–7)"};return field<20?labels[field]:"Invalid field";}
static gboolean lpcflash_parse(unsigned field,const char*text,unsigned char*out){if(field>=20||!text||!*text||strlen(text)>2)return FALSE;for(const char*p=text;*p;p++)if(!g_ascii_isxdigit(*p))return FALSE;char*end;guint64 n=g_ascii_strtoull(text,&end,16);if(*end||n>(field<4?255:7))return FALSE;*out=(unsigned char)n;return TRUE;}
static char*lpcflash_configuration_message(unsigned fields,const unsigned char*values,gboolean edited){GString*s=g_string_new(edited?"Configuration written and read back.\n":"Configuration read.\n");for(unsigned i=0;i<fields;i++)g_string_append_printf(s,"%s: %02X\n",lpcflash_label(i),values[i]);g_string_append(s,"Code Read unavailable. Cleanup completed.");return g_string_free(s,FALSE);}
typedef struct{app_widgets*w;GtkWindow*window;GtkWidget*enable[20],*value[20],*sector[16],*preserve,*error;unsigned fields,maximum[20];size_t device;uint64_t revision;}lpcflash_editor;
static void lpcflash_editor_action(GtkButton*button,gpointer data){lpcflash_editor*e=data;app_widgets*w=e->w;if(!w->has_selected_device||w->selected_device_index!=e->device||w->operation_input_revision!=e->revision){gtk_window_destroy(e->window);return;}unsigned char packet[24]={0};uint32_t mask=0;int action=GPOINTER_TO_INT(g_object_get_data(G_OBJECT(button),"action"));if(action==1)for(unsigned i=0;i<e->fields;i++){if(!gtk_check_button_get_active(GTK_CHECK_BUTTON(e->enable[i])))continue;if(!lpcflash_parse(i,gtk_editable_get_text(GTK_EDITABLE(e->value[i])),packet+4+i)||packet[4+i]>e->maximum[i]){gtk_label_set_text(GTK_LABEL(e->error),"Enter a hexadecimal value within the field range.");return;}mask|=1u<<i;}
 unsigned sectors=0;for(unsigned i=0;i<e->fields-4;i++)if(gtk_check_button_get_active(GTK_CHECK_BUTTON(e->sector[i])))sectors|=1u<<i;if(!sectors){gtk_label_set_text(GTK_LABEL(e->error),"Select at least one erase sector.");return;}for(unsigned i=0;i<4;i++)packet[i]=(unsigned char)(mask>>(8*i));memcpy(w->lpcflash_configuration,packet,24);w->lpcflash_sector_mask=sectors;w->lpcflash_preserve_isp=gtk_check_button_get_active(GTK_CHECK_BUTTON(e->preserve));gtk_drop_down_set_selected(GTK_DROP_DOWN(w->operation_dropdown),action==2?6:9);gtk_window_destroy(e->window);w->read_after_prepare=0;start_operation_preparation(w,action==2?LT48_OPERATION_ERASE:LT48_OPERATION_CONFIGURATION);
}
static void lpcflash_editor_open(app_widgets*w){lt48_lpcflash_resources*r=NULL;if(lt48_lpcflash_open(w->installation,w->selected_device_index,&r))return;unsigned fields=lt48_lpcflash_field_count(r);int isp=lt48_lpcflash_has_isp_choice(r);unsigned maximum[20]={0};for(unsigned i=0;i<fields;i++)maximum[i]=lt48_lpcflash_field_max(r,i);lt48_lpcflash_close(r);lpcflash_editor*e=g_new0(lpcflash_editor,1);e->w=w;e->fields=fields;memcpy(e->maximum,maximum,sizeof maximum);e->device=w->selected_device_index;e->revision=w->operation_input_revision;e->window=GTK_WINDOW(gtk_window_new());gtk_window_set_title(e->window,"P89LPC Flash configuration and erase");gtk_window_set_transient_for(e->window,w->window);gtk_window_set_modal(e->window,TRUE);gtk_window_set_default_size(e->window,650,700);GtkWidget*scroll=gtk_scrolled_window_new(),*box=gtk_box_new(GTK_ORIENTATION_VERTICAL,8);gtk_window_set_child(e->window,scroll);gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(scroll),box);GtkWidget*intro=gtk_label_new("Code Read is unavailable. Configuration can be read. Code verification uses sector CRCs.\nCheck only fields to change; other values are preserved. Displayed values are proposed edits, not a live read. Security bits can be added; clearing them requires sector/global erase. Mask1 blocks code/CRC reads, 2 blocks programming/page erase, 4 blocks sector erase; combine bits. Global erase can clear security. Boot and oscillator settings affect device operation.\nProgram erases the full code array first and requires all sectors, including ISP. Erase choices below apply to Erase.");gtk_label_set_wrap(GTK_LABEL(intro),TRUE);gtk_box_append(GTK_BOX(box),intro);
 for(unsigned i=0;i<fields;i++){GtkWidget*row=gtk_box_new(GTK_ORIENTATION_HORIZONTAL,8);char*label=maximum[i]<(i<4?255u:7u)?g_strdup_printf("%s — maximum %02X",lpcflash_label(i),maximum[i]):g_strdup(lpcflash_label(i));e->enable[i]=gtk_check_button_new_with_label(label);g_free(label);e->value[i]=gtk_entry_new();gtk_editable_set_text(GTK_EDITABLE(e->value[i]),i==0?"63":"00");gtk_box_append(GTK_BOX(row),e->enable[i]);gtk_box_append(GTK_BOX(row),e->value[i]);gtk_box_append(GTK_BOX(box),row);}
 e->preserve=gtk_check_button_new_with_label("Preserve factory ISP loader during Erase");gtk_check_button_set_active(GTK_CHECK_BUTTON(e->preserve),isp&&w->lpcflash_preserve_isp);gtk_widget_set_sensitive(e->preserve,isp);gtk_box_append(GTK_BOX(box),e->preserve);
 for(unsigned i=0;i<fields-4;i++){char label[48];g_snprintf(label,sizeof label,"Erase sector %u",i);e->sector[i]=gtk_check_button_new_with_label(label);gtk_check_button_set_active(GTK_CHECK_BUTTON(e->sector[i]),!isp||!w->lpcflash_sector_mask||!!(w->lpcflash_sector_mask&(1u<<i)));gtk_widget_set_sensitive(e->sector[i],isp);gtk_box_append(GTK_BOX(box),e->sector[i]);}
 e->error=gtk_label_new("");gtk_box_append(GTK_BOX(box),e->error);const char*buttons[]={"Prepare configuration read","Prepare selected setting changes","Prepare selected erase"};for(unsigned i=0;i<3;i++){GtkWidget*b=gtk_button_new_with_label(buttons[i]);g_object_set_data(G_OBJECT(b),"action",GINT_TO_POINTER(i));g_signal_connect(b,"clicked",G_CALLBACK(lpcflash_editor_action),e);gtk_box_append(GTK_BOX(box),b);}g_object_set_data_full(G_OBJECT(e->window),"lpcflash-editor",e,g_free);gtk_window_present(e->window);}
