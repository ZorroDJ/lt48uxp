/* Stage a PSoC Designer security record; editing does not access hardware. */
static gboolean p29_parse_security_n(const char*text,unsigned char*out,unsigned length){
 unsigned n=0,half=0,hi=0;for(const unsigned char*p=(const unsigned char*)text;*p;p++){if(g_ascii_isspace(*p))continue;int v=g_ascii_xdigit_value(*p);if(v<0||n>=length)return FALSE;if(!half){hi=v;half=1;}else{out[n++]=(hi<<4)|v;half=0;}}return n==length&&!half;
}
static G_GNUC_UNUSED gboolean p29_parse_security(const char*text,unsigned char out[64]){return p29_parse_security_n(text,out,64);}
