# LabTool-48UXP identities recovered from the original client.
# Install as /etc/udev/rules.d/70-labtool48.rules, then reload udev rules.
SUBSYSTEM=="usb", ATTR{idVendor}=="11b5", ATTR{idProduct}=="2003", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="11b5", ATTR{idProduct}=="2004", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="11b5", ATTR{idProduct}=="2005", MODE="0660", TAG+="uaccess"
